# Root .dockerignore (task 6.3).
# Applied to the api and collector images, which build from the repo root.

# Git and CI
.git
.github
.gitignore

# Environment and secrets
.env
.env.*
!.env.example
deploy/
agent/

# Docs and tests
docs/
tests/
*.md

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/

# Runtime data
*.log
*.db
*.sqlite3
data/
pgdata/

# Editor / OS
.vscode/
.idea/
.DS_Store
