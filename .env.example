# Postgres (tasks 1.3, 6.1)
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=honeyforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://honeyforge:change-me-in-production@postgres:5432/honeyforge

# Control API / operator auth (task 2.6)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Nginx / external entrypoint (tasks 6.4, 4.2)
CENTER_DOMAIN=localhost
CENTER_URL=https://localhost
CENTER_HTTP_PORT=80
CENTER_HTTPS_PORT=443

# Agent channel (tasks 3.4, 4.1, 4.2)
AGENT_TOKEN=change-me-in-production
TELEMETRY_PATH=/assets/v2/init
CENTER_MASK_DOMAIN=assets.cdn-static.example
AGENT_CENTER_URL=https://assets.cdn-static.example

# Honeypot fleet (task 6.2)
HONEYPOT_ID_LOW=low-01
HONEYPOT_ID_MEDIUM=medium-01

# Agent beacon and process masking (tasks 4.4, 4.5)
BEACON_INTERVAL_SECONDS=60
BEACON_JITTER_SECONDS=30
PROCESS_NAME=syslog-relay
VERIFY_TLS=0

# Certificate generation (task 6.5)
CERT_DAYS=365
CERT_SUBJECT=/CN=localhost
CERT_SAN=DNS:localhost,IP:127.0.0.1
