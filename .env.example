# Postgres (tasks 1.3, 6.1)
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=honeyforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://honeyforge:change-me-in-production@postgres:5432/honeyforge

# Control API / operator auth (task 2.6)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=
OPERATOR_ROLE=admin

# Nginx / external entrypoint (tasks 6.4, 4.2)
CENTER_DOMAIN=localhost
CENTER_URL=https://localhost
CENTER_HTTP_PORT=80
CENTER_HTTPS_PORT=8443
CENTER_TLS_CERT_FILE=./nginx/certs/center.crt
CENTER_TLS_KEY_FILE=./nginx/certs/center.key
TRUSTED_PROXY_IPS=172.30.0.10

# Agent channel (tasks 3.4, 4.1, 4.2)
AGENT_TOKEN=change-me-in-production
TELEMETRY_PATH=/assets/v2/init
ENROLLMENT_TOKEN_MINUTES=10
TRAP_SECRET_OVERLAP_MINUTES=5
HEALTH_TIMEOUT_SECONDS=90
HEALTH_SWEEP_INTERVAL_SECONDS=30
SECURITY_DATA_RETENTION_DAYS=30
AUDIT_ENTRY_RETENTION_DAYS=365
RETENTION_SWEEP_INTERVAL_SECONDS=86400
CENTER_MASK_DOMAIN=assets.cdn-static.example
AGENT_CENTER_URL=https://assets.cdn-static.example
CENTER_CA_CERT_FILE=./nginx/certs/ca.crt
LOW_TRAP_SECRET_FILE=../secrets/low_trap_secret
LOW_SSH_PORT=2222
LOW_HTTP_PORT=8080
LOW_MYSQL_PORT=33060
MEDIUM_TRAP_SECRET_FILE=../secrets/medium_trap_secret
MEDIUM_SSH_PORT=2223
MEDIUM_HTTP_PORT=8081
LOW_SSH_INTERNAL_PORT=22
EVENT_QUEUE_MAX_EVENTS=100000
EVENT_QUEUE_MAX_BYTES=268435456
HEALTH_INTERVAL_SECONDS=30
DELIVERY_INTERVAL_SECONDS=1
AGENT_VERSION=0.1.0

# Honeypot fleet (task 6.2)
PROCESS_MASK_NAME=syslog-relay

# Agent beacon timing
BEACON_INTERVAL_SECONDS=60
BEACON_JITTER_SECONDS=30

# Certificate generation (task 6.5)
CERT_DAYS=365
CERT_SUBJECT=/CN=assets.cdn-static.example
CERT_SAN=DNS:localhost,DNS:assets.cdn-static.example,IP:127.0.0.1
