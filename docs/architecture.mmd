flowchart LR
    subgraph ATTACKER["🌍 Атакующий (Internet)"]
        A1[Сканер портов]
        A2[SSH-брутфорс]
        A3[Веб-эксплойт]
    end

    subgraph DMZ["🔥 DMZ — парк ловушек"]
        direction TB
        subgraph HP_LOW["Low-interaction honeypot"]
            L1[TCP listener + banner]
            L2[HTTP fake]
            L3[SSH banner]
        end
        subgraph HP_MED["Medium-interaction honeypot"]
            M1[Fake SSH]
            M2[Fake HTTP admin]
            M3[Fake FS / shell]
        end
        AG_COMMON["agent/common<br/>buffer · client · channel"]
        MASK["Nginx masking<br/>/assets/v2/* → /api/telemetry"]
        TOK["Honeytokens (bonus)"]
    end

    subgraph CENTER["🛡 Control Plane — изолированный сервер"]
        direction TB
        NGX["Nginx<br/>TLS + reverse-proxy"]
        API["FastAPI<br/>routers · services · security"]
        COLL["Collector<br/>ingest · normalize · geoip"]
        WS["WS Manager + pg_listener"]
        ORCH["Orchestrator (bonus)"]
        WEB["Web UI<br/>dashboard · events · profiles"]

        subgraph DB["PostgreSQL"]
            T1[(profiles)]
            T2[(honeypots)]
            T3[(events)]
            T4[(sessions)]
            T5[(honeytokens)]
            T6[(audit)]
            T7[(operators)]
        end
    end

    OP["👤 Оператор SOC"]

    A1 --> HP_LOW
    A2 --> HP_MED
    A3 --> HP_MED

    HP_LOW --> AG_COMMON
    HP_MED --> AG_COMMON
    TOK -.срабатывание.-> AG_COMMON

    AG_COMMON -- "TLS + jitter<br/>POST /assets/v2/init" --> MASK
    MASK -- "proxy_pass" --> NGX
    NGX --> API

    API --> COLL
    COLL --> DB
    DB -. "NOTIFY events_new" .-> WS
    API <--> WS
    API --> WEB

    OP --> NGX
    OP -- "WebSocket /ws/events" --> WS
    OP -- "JWT + CRUD" --> API

    ORCH -. "compose + ssh" .-> DMZ

    classDef attack fill:#ffd8d8,stroke:#c00
    classDef dmz fill:#fff4d6,stroke:#c90
    classDef center fill:#d8ebff,stroke:#069
    class A1,A2,A3 attack
    class L1,L2,L3,M1,M2,M3,AG_COMMON,MASK,TOK dmz
    class NGX,API,COLL,WS,ORCH,WEB center
