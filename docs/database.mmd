%% HoneyForge — схема базы данных (6 таблиц, ADR-0004)
%% Колонки соответствуют center/api/models/*.py и миграциям 0001–0006.
erDiagram
    TRAP_PROFILES ||--o{ TRAPS : "назначает"
    TRAPS ||--o{ ATTACK_SESSIONS : "наблюдает"
    TRAPS ||--o{ SECURITY_EVENTS : "производит"
    ATTACK_SESSIONS ||--o{ SECURITY_EVENTS : "группирует"
    OPERATORS ||--o{ AUDIT_ENTRIES : "пишет"

    TRAP_PROFILES {
        uuid id PK
        text name UK
        text interaction_level "CHECK low|medium"
        jsonb services "протокол, порт, баннер, emulator_settings"
        jsonb banners "устаревшее, не заполняется API"
        jsonb config "устаревшее, не заполняется API"
        jsonb decoy_credentials "учётные данные-приманки"
        jsonb logging "что и в каком объёме логируется"
        jsonb masking "beacon-интервал, джиттер, user_agent"
        int version "оптимистичная блокировка If-Match"
        bool is_archived
        timestamptz created_at
        timestamptz updated_at
    }

    TRAPS {
        uuid id PK
        text name
        uuid trap_profile_id FK "RESTRICT"
        inet ip_address
        text hostname
        text region
        text status "CHECK provisioning|online|degraded|offline|revoked"
        bool enabled "желаемое состояние оператора"
        bool is_archived
        text agent_version
        jsonb agent_meta
        timestamptz last_seen_at
        text enrollment_token_hash
        timestamptz enrollment_token_expires_at
        timestamptz enrollment_token_used_at
        text current_secret_hash
        text previous_secret_hash
        timestamptz previous_secret_valid_until
        timestamptz created_at
    }

    ATTACK_SESSIONS {
        uuid id PK
        uuid trap_id FK "RESTRICT"
        inet source_ip
        timestamptz started_at
        timestamptz ended_at "для HTTP — по неактивности"
        text protocol
        jsonb metadata
    }

    SECURITY_EVENTS {
        uuid id PK "ключ идемпотентности"
        int schema_version "1 или 2"
        uuid trap_id FK "RESTRICT"
        uuid attack_session_id FK "RESTRICT"
        text event_type "CHECK по семи типам"
        timestamptz observed_at "задаёт агент"
        timestamptz received_at "задаёт только центр"
        inet source_ip
        int source_port
        text target_service
        int target_port
        jsonb payload
    }

    OPERATORS {
        uuid id PK
        text username UK
        text password_hash "scrypt"
        text role "admin или viewer"
        bool is_active
        int session_version "сброс всех сессий"
        timestamptz last_login_at
        timestamptz created_at
    }

    AUDIT_ENTRIES {
        bigserial id PK
        uuid operator_id FK "оператор"
        text action "trap.created, trap.revoked, operator.access.denied…"
        text entity "trap, trap_profile, operator"
        uuid entity_id
        jsonb details
        inet source_ip
        timestamptz created_at
    }